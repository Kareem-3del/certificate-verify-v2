<%- include('layouts/base', {
  title: 'Settings Dashboard - CertifyPro',
  body: `
    <div class="min-h-screen flex">
      <!-- Sidebar -->
      ${include('components/sidebar')}
      
      <!-- Main Content -->
      <div class="flex-1 flex flex-col">
        <!-- Header -->
        ${include('components/header')}
        
        <!-- Dashboard Content -->
        <main class="flex-1 p-6 overflow-y-auto">
          <!-- Settings Configuration Section -->
          ${include('components/settings-config')}
          
          <!-- Certificates Management Section -->
          ${include('components/certificates-section')}
          
          <!-- Users Management Section -->
          ${include('components/users-section')}
          
          <!-- Analytics Section -->
          ${include('components/analytics-section')}
        </main>
      </div>
    </div>
    
    <!-- Global JavaScript for section management -->
    <script>
      // Initialize the dashboard
      document.addEventListener('DOMContentLoaded', function() {
        // Initialize Lucide icons
        lucide.createIcons();
        
        // Show default settings page (general)
        showSettingsPage('general');
        
        // Load initial data
        if (typeof loadCertificates === 'function') {
          // Will be called when certificates section is shown
        }
        
        if (typeof loadUsers === 'function') {
          // Will be called when users section is shown  
        }
        
        if (typeof loadAnalytics === 'function') {
          // Will be called when analytics section is shown
        }
        
        // Add smooth transitions to all sections
        document.querySelectorAll('.content-section').forEach(section => {
          section.style.transition = 'opacity 0.3s ease-in-out';
        });
        
        // Update active states on page load
        updateSidebarCounts();
      });
      
      // Global function to show sections (defined in sidebar.ejs but enhanced here)
      function showSection(sectionName) {
        // Hide all sections with fade effect
        document.querySelectorAll('.content-section').forEach(section => {
          section.style.opacity = '0';
          setTimeout(() => {
            section.classList.add('hidden');
          }, 150);
        });
        
        // Show selected section with fade effect
        setTimeout(() => {
          const targetSection = document.getElementById(sectionName);
          if (targetSection) {
            targetSection.classList.remove('hidden');
            setTimeout(() => {
              targetSection.style.opacity = '1';
            }, 50);
          }
          
          // Update sidebar active state
          document.querySelectorAll('.sidebar-item').forEach(item => {
            item.classList.remove('active');
          });
          
          const activeItem = document.querySelector(\`[data-section="\${sectionName}"]\`);
          if (activeItem) {
            activeItem.classList.add('active');
          }
          
          // Load section-specific data
          if (sectionName === 'certificates' && typeof loadCertificates === 'function') {
            loadCertificates();
          } else if (sectionName === 'users' && typeof loadUsers === 'function') {
            loadUsers();
          } else if (sectionName === 'analytics' && typeof loadAnalytics === 'function') {
            loadAnalytics();
          }
          
          // Update page title
          const titles = {
            settings: 'Certificate Settings',
            certificates: 'Certificate Management', 
            users: 'User Management',
            analytics: 'Analytics Dashboard'
          };
          
          if (titles[sectionName]) {
            document.title = \`\${titles[sectionName]} - CertifyPro\`;
          }
        }, 150);
      }
      
      // Update sidebar counts and status indicators
      function updateSidebarCounts() {
        // This will be called periodically or when data changes
        
        // Mock certificate count update
        setTimeout(() => {
          const certCount = document.getElementById('certificates-count');
          if (certCount) {
            certCount.textContent = '1,234';
          }
        }, 1000);
        
        // System status update (could be enhanced with real API calls)
        const systemStatus = document.querySelector('.bg-gradient-to-br.from-green-50');
        if (systemStatus) {
          // System is healthy - no changes needed
        }
      }
      
      // Auto-refresh system status every 30 seconds
      setInterval(() => {
        updateSidebarCounts();
      }, 30000);
      
      // Handle browser back/forward buttons for section navigation
      window.addEventListener('popstate', function(e) {
        const section = e.state?.section || 'settings';
        showSection(section);
      });
      
      // Update browser history when changing sections
      const originalShowSection = showSection;
      showSection = function(sectionName) {
        originalShowSection(sectionName);
        history.pushState({section: sectionName}, '', \`#\${sectionName}\`);
      };
      
      // Update browser history when changing settings pages
      const originalShowSettingsPage = showSettingsPage;
      showSettingsPage = function(pageName) {
        originalShowSettingsPage(pageName);
        history.pushState({page: pageName}, '', \`#\${pageName}\`);
      };
      
      // Handle initial URL hash
      if (window.location.hash) {
        const hash = window.location.hash.replace('#', '');
        const validSections = ['users', 'analytics'];
        const validPages = ['general', 'certificates', 'email', 'subscriptions'];
        
        if (validSections.includes(hash)) {
          setTimeout(() => showSection(hash), 100);
        } else if (validPages.includes(hash)) {
          setTimeout(() => showSettingsPage(hash), 100);
        }
      }
      
      // Global keyboard shortcuts
      document.addEventListener('keydown', function(e) {
        // Alt + 1-4 for quick section navigation
        if (e.altKey && !e.ctrlKey && !e.shiftKey) {
          switch(e.code) {
            case 'Digit1':
              e.preventDefault();
              showSection('settings');
              break;
            case 'Digit2':
              e.preventDefault();
              showSection('certificates');
              break;
            case 'Digit3':
              e.preventDefault();
              showSection('users');
              break;
            case 'Digit4':
              e.preventDefault();
              showSection('analytics');
              break;
          }
        }
        
        // Ctrl + R for refresh current section
        if (e.ctrlKey && e.code === 'KeyR') {
          e.preventDefault();
          const activeSection = document.querySelector('.sidebar-item.active')?.getAttribute('data-section');
          if (activeSection) {
            window.showToast(\`Refreshing \${activeSection} section...\`, 'info');
            showSection(activeSection);
          }
        }
      });
      
      // Add tooltips for keyboard shortcuts
      document.addEventListener('DOMContentLoaded', function() {
        const shortcuts = [
          { selector: '[data-section="settings"]', text: 'Alt+1' },
          { selector: '[data-section="certificates"]', text: 'Alt+2' },
          { selector: '[data-section="users"]', text: 'Alt+3' },
          { selector: '[data-section="analytics"]', text: 'Alt+4' }
        ];
        
        shortcuts.forEach(shortcut => {
          const element = document.querySelector(shortcut.selector);
          if (element) {
            element.title = \`Keyboard shortcut: \${shortcut.text}\`;
          }
        });
      });
    </script>
  `
}) %>
