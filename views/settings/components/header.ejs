<!-- Modern Header for Settings Dashboard -->
<header class="glass-effect border-b border-gray-200 sticky top-0 z-40">
  <div class="px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo and Title -->
      <div class="flex items-center space-x-4">
        <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center shadow-lg">
          <i data-lucide="settings" class="w-6 h-6 text-white"></i>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Settings Dashboard</h1>
          <p class="text-sm text-gray-500">Manage your certificate system configuration</p>
        </div>
      </div>

      <!-- Header Actions -->
      <div class="flex items-center space-x-4">
        <!-- Quick Stats -->
        <div class="hidden lg:flex items-center space-x-6 mr-6">
          <div class="text-center">
            <div class="text-lg font-semibold text-gray-900"><%= settings ? settings.length : 0 %></div>
            <div class="text-xs text-gray-500">Configurations</div>
          </div>
          <div class="text-center">
            <div class="text-lg font-semibold text-green-600">Active</div>
            <div class="text-xs text-gray-500">System Status</div>
          </div>
        </div>

        <!-- User Menu -->
        <div class="relative group">
          <button class="flex items-center space-x-3 p-2 rounded-lg hover:bg-gray-100 transition-colors duration-200">
            <div class="w-8 h-8 bg-gradient-to-br from-primary-400 to-primary-600 rounded-full flex items-center justify-center">
              <i data-lucide="user" class="w-4 h-4 text-white"></i>
            </div>
            <div class="hidden sm:block text-left">
              <p class="text-sm font-medium text-gray-900">Administrator</p>
              <p class="text-xs text-gray-500">System Admin</p>
            </div>
            <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400"></i>
          </button>
          
          <!-- Dropdown Menu -->
          <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0">
            <div class="py-2">
              <a href="/" class="flex items-center space-x-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <i data-lucide="home" class="w-4 h-4"></i>
                <span>Main Dashboard</span>
              </a>
              <a href="/settings/email" class="flex items-center space-x-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <i data-lucide="mail" class="w-4 h-4"></i>
                <span>Bulk Email</span>
              </a>
              <a href="/settings/sub" class="flex items-center space-x-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <i data-lucide="credit-card" class="w-4 h-4"></i>
                <span>Subscriptions</span>
              </a>
              <hr class="my-2">
              <a href="/auth/logout" class="flex items-center space-x-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                <span>Logout</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>