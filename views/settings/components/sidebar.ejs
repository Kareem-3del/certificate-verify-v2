<script>
function showSection(sectionName) {
  // Hide all sections and settings pages
  document.querySelectorAll('.content-section').forEach(section => {
    section.classList.add('hidden');
  });
  document.querySelectorAll('.settings-page').forEach(page => {
    page.classList.add('hidden');
  });
  
  // Show selected section
  const targetSection = document.getElementById(sectionName);
  if (targetSection) {
    targetSection.classList.remove('hidden');
  }
  
  // Update sidebar active state
  document.querySelectorAll('.sidebar-item').forEach(item => {
    item.classList.remove('active');
  });
  
  const activeItem = document.querySelector(`[data-section="${sectionName}"]`);
  if (activeItem) {
    activeItem.classList.add('active');
  }
  
  // Load section-specific data
  if (sectionName === 'certificates') {
    loadCertificates();
  } else if (sectionName === 'users') {
    loadUsers();
  } else if (sectionName === 'analytics') {
    loadAnalytics();
  }
}

function showSettingsPage(pageName) {
  // Hide all sections and settings pages
  document.querySelectorAll('.content-section').forEach(section => {
    section.classList.add('hidden');
  });
  document.querySelectorAll('.settings-page').forEach(page => {
    page.classList.add('hidden');
  });
  
  // Show the settings container and specific page
  const settingsSection = document.getElementById('settings');
  if (settingsSection) {
    settingsSection.classList.remove('hidden');
  }
  
  const targetPage = document.getElementById(`${pageName}-settings`);
  if (targetPage) {
    targetPage.classList.remove('hidden');
  }
  
  // Update sidebar active state
  document.querySelectorAll('.sidebar-item').forEach(item => {
    item.classList.remove('active');
  });
  
  const activeItem = document.querySelector(`[data-page="${pageName}"]`);
  if (activeItem) {
    activeItem.classList.add('active');
  }
  
  // Update page title
  const titles = {
    general: 'General Settings',
    certificates: 'Certificate Settings',
    email: 'Email & Bulk Mail Settings',
    subscriptions: 'Subscription Management'
  };
  
  if (titles[pageName]) {
    document.title = `${titles[pageName]} - CertifyPro`;
  }
}

function exportAllData() {
  window.showToast('Starting data export...', 'info');
  // Add export functionality here
}

function showBackupModal() {
  window.showToast('Backup feature coming soon!', 'info');
  // Add backup modal functionality here
}
</script>