<script>
let analyticsData = {};

async function loadAnalytics(dateRange = 30) {
  try {
    showLoadingState();
    
    const response = await fetch(`/certificates/analytics/dashboard?dateRange=${dateRange}`);
    const result = await response.json();
    
    if (result.success) {
      analyticsData = result.data;
      updateAnalyticsDisplay();
      updateChartsWithRealData();
      updateRecentActivity();
      updateSystemHealthDisplay();
    } else {
      throw new Error(result.error || 'Failed to load analytics');
    }
    
    hideLoadingState();
    
  } catch (error) {
    console.error('Error loading analytics:', error);
    window.showToast('Error loading analytics data', 'error');
    hideLoadingState();
    
    // Fallback to mock data
    loadMockAnalytics();
  }
}

function loadMockAnalytics() {
  analyticsData = {
    overview: {
      totalCertificates: 1234,
      activeUsers: 89,
      expiringSoon: 23,
      totalRevenue: 12450,
      growthMetrics: {
        certificatesGrowth: 12,
        usersGrowth: 5,
        revenueGrowth: 18
      }
    },
    certificateTypes: [
      { name: 'CPR Certification', count: 555, percentage: 45 },
      { name: 'First Aid', count: 395, percentage: 32 },
      { name: 'AED Training', count: 284, percentage: 23 }
    ],
    issuanceTrend: [
      { date: '2024-01-01', certificates: 45, renewals: 12 },
      { date: '2024-01-02', certificates: 32, renewals: 8 },
      { date: '2024-01-03', certificates: 67, renewals: 15 },
      { date: '2024-01-04', certificates: 41, renewals: 10 },
      { date: '2024-01-05', certificates: 58, renewals: 14 },
      { date: '2024-01-06', certificates: 38, renewals: 9 },
      { date: '2024-01-07', certificates: 29, renewals: 7 }
    ],
    recentActivity: [
      {
        type: 'certificate_issued',
        description: 'New certificate issued',
        details: 'CPR Certificate #CRT-2024-001234',
        timestamp: new Date(Date.now() - 2 * 60 * 1000).toISOString()
      },
      {
        type: 'user_registered',
        description: 'New user registered',
        details: 'john.doe@example.com',
        timestamp: new Date(Date.now() - 15 * 60 * 1000).toISOString()
      }
    ]
  };
  
  updateAnalyticsDisplay();
  updateChartsWithRealData();
}

function updateAnalyticsDisplay() {
  const overview = analyticsData.overview || analyticsData;
  
  // Update main metrics
  document.getElementById('totalCertificates').textContent = (overview.totalCertificates || 0).toLocaleString();
  document.getElementById('activeUsers').textContent = (overview.activeUsers || 0).toString();
  document.getElementById('expiringSoon').textContent = (overview.expiringSoon || 0).toString();
  document.getElementById('totalRevenue').textContent = `$${(overview.totalRevenue || 0).toLocaleString()}`;
  
  // Update growth indicators
  if (overview.growthMetrics) {
    updateGrowthIndicator('totalCertificates', overview.growthMetrics.certificatesGrowth);
    updateGrowthIndicator('activeUsers', overview.growthMetrics.usersGrowth);
    updateGrowthIndicator('totalRevenue', overview.growthMetrics.revenueGrowth);
  }
}

function updateGrowthIndicator(elementId, growth) {
  const element = document.getElementById(elementId);
  if (!element) return;
  
  const parentCard = element.closest('.bg-white');
  if (!parentCard) return;
  
  const growthElement = parentCard.querySelector('.text-xs.text-green-600, .text-xs.text-red-600, .text-xs.text-gray-600');
  if (!growthElement) return;
  
  const isPositive = growth > 0;
  const isNegative = growth < 0;
  
  growthElement.className = `text-xs mt-1 ${isPositive ? 'text-green-600' : isNegative ? 'text-red-600' : 'text-gray-600'}`;
  
  const icon = isPositive ? 'trending-up' : isNegative ? 'trending-down' : 'minus';
  const sign = isPositive ? '+' : '';
  
  growthElement.innerHTML = `
    <i data-lucide="${icon}" class="w-3 h-3 inline mr-1"></i>
    ${sign}${growth}% from last month
  `;
  
  // Re-initialize Lucide icons for the new icon
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

function updateChartsWithRealData() {
  updateIssuanceTrendChart();
  updateCertificateTypesChart();
}

function updateIssuanceTrendChart() {
  const chartContainer = document.getElementById('certificateChart');
  if (!chartContainer || !analyticsData.issuanceTrend) return;
  
  const trendData = analyticsData.issuanceTrend.slice(-7); // Last 7 days
  const maxValue = Math.max(...trendData.map(d => d.certificates || 0));
  
  chartContainer.innerHTML = '';
  
  trendData.forEach((data, index) => {
    const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const date = new Date(data.date);
    const dayName = dayNames[date.getDay()];
    const height = Math.max((data.certificates / maxValue) * 180, 20);
    
    const barContainer = document.createElement('div');
    barContainer.className = 'flex flex-col items-center space-y-2';
    barContainer.innerHTML = `
      <div class="w-8 bg-primary-500 rounded-t" style="height: ${height}px;" title="${data.certificates} certificates"></div>
      <span class="text-xs text-gray-600">${dayName}</span>
    `;
    
    chartContainer.appendChild(barContainer);
  });
}

function updateCertificateTypesChart() {
  const chartContainer = document.querySelector('.space-y-4');
  if (!chartContainer || !analyticsData.certificateTypes) return;
  
  // Find the certificate types container
  const typesContainer = chartContainer.closest('.bg-white');
  if (!typesContainer) return;
  
  const dataContainer = typesContainer.querySelector('.space-y-4');
  if (!dataContainer) return;
  
  dataContainer.innerHTML = '';
  
  const colors = ['blue-500', 'green-500', 'yellow-500', 'purple-500', 'red-500'];
  
  analyticsData.certificateTypes.forEach((type, index) => {
    const color = colors[index % colors.length];
    const percentage = type.percentage || Math.round((type.count / analyticsData.overview.totalCertificates) * 100);
    
    const typeElement = document.createElement('div');
    typeElement.className = 'flex items-center justify-between';
    typeElement.innerHTML = `
      <div class="flex items-center space-x-3">
        <div class="w-4 h-4 bg-${color} rounded-full"></div>
        <span class="text-sm font-medium text-gray-700">${type.name}</span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-sm font-medium text-gray-900">${percentage}%</span>
        <div class="w-20 h-2 bg-gray-200 rounded-full">
          <div class="h-2 bg-${color} rounded-full" style="width: ${percentage}%"></div>
        </div>
      </div>
    `;
    
    dataContainer.appendChild(typeElement);
  });
}

function updateRecentActivity() {
  const activityContainer = document.getElementById('recentActivity');
  if (!activityContainer || !analyticsData.recentActivity) return;
  
  activityContainer.innerHTML = '';
  
  analyticsData.recentActivity.forEach(activity => {
    const timeAgo = getTimeAgo(new Date(activity.timestamp));
    const iconMap = {
      certificate_issued: { icon: 'plus-circle', color: 'green' },
      user_registered: { icon: 'user-plus', color: 'blue' },
      certificate_renewed: { icon: 'refresh-cw', color: 'yellow' },
      payment_received: { icon: 'credit-card', color: 'purple' }
    };
    
    const iconData = iconMap[activity.type] || { icon: 'info', color: 'gray' };
    
    const activityElement = document.createElement('div');
    activityElement.className = 'flex items-start space-x-3';
    activityElement.innerHTML = `
      <div class="w-8 h-8 bg-${iconData.color}-100 rounded-full flex items-center justify-center mt-0.5">
        <i data-lucide="${iconData.icon}" class="w-4 h-4 text-${iconData.color}-600"></i>
      </div>
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-900">${activity.description}</p>
        <p class="text-xs text-gray-500">${activity.details}</p>
        <p class="text-xs text-gray-400">${timeAgo}</p>
      </div>
    `;
    
    activityContainer.appendChild(activityElement);
  });
  
  // Re-initialize Lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

function updateSystemHealthDisplay() {
  if (!analyticsData.systemHealth) return;
  
  const healthData = analyticsData.systemHealth;
  const systemHealthElements = {
    database: document.querySelector('.text-sm:contains("Database")'),
    emailService: document.querySelector('.text-sm:contains("Email Service")'),
    storage: document.querySelector('.text-sm:contains("Storage")'),
    pdfGenerator: document.querySelector('.text-sm:contains("PDF Generator")')
  };
  
  Object.keys(healthData).forEach(service => {
    const serviceData = healthData[service];
    const statusColor = serviceData.status === 'healthy' ? 'green' : 
                       serviceData.status === 'warning' ? 'yellow' : 'red';
    
    // Update status indicators if elements exist
    // This would require more specific selectors in the actual implementation
  });
}

function showLoadingState() {
  const metricsCards = document.querySelectorAll('.text-2xl.font-bold');
  metricsCards.forEach(card => {
    card.innerHTML = '<div class="animate-pulse bg-gray-200 h-8 w-16 rounded"></div>';
  });
}

function hideLoadingState() {
  // Loading state will be hidden when updateAnalyticsDisplay is called
}

function getTimeAgo(date) {
  const now = new Date();
  const diffInSeconds = Math.floor((now - date) / 1000);
  
  if (diffInSeconds < 60) return `${diffInSeconds} seconds ago`;
  if (diffInSeconds < 3600) return `${Math.floor(diffInSeconds / 60)} minutes ago`;
  if (diffInSeconds < 86400) return `${Math.floor(diffInSeconds / 3600)} hours ago`;
  return `${Math.floor(diffInSeconds / 86400)} days ago`;
}

