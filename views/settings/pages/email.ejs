<script>
let currentRecipientMode = 'manual';
let currentEditorMode = 'wysiwyg';
let attachmentCount = 0;

// Initialize email functionality
document.addEventListener('DOMContentLoaded', function() {
  loadAllEmails();
  
  // Update recipient count on input
  document.getElementById('recipients').addEventListener('input', updateRecipientCount);
  
  // Handle send time change
  document.getElementById('sendTime').addEventListener('change', function() {
    const scheduleDiv = document.getElementById('scheduleTime');
    if (this.value === 'schedule') {
      scheduleDiv.classList.remove('hidden');
    } else {
      scheduleDiv.classList.add('hidden');
    }
  });
  
  // Form submission
  document.getElementById('bulkEmailForm').addEventListener('submit', handleFormSubmit);
});

function setRecipientMode(mode) {
  currentRecipientMode = mode;
  
  // Update tab appearance
  document.querySelectorAll('.recipient-tab').forEach(tab => {
    tab.classList.remove('active');
  });
  document.querySelector(`[data-mode="${mode}"]`).classList.add('active');
  
  // Show/hide panels
  document.querySelectorAll('.recipient-panel').forEach(panel => {
    panel.classList.add('hidden');
  });
  
  const panelMap = {
    'manual': 'manualRecipients',
    'filter': 'filterRecipients',
    'import': 'importRecipients'
  };
  
  document.getElementById(panelMap[mode]).classList.remove('hidden');
}

function toggleEditor(mode) {
  currentEditorMode = mode;
  
  // Update tab appearance
  document.querySelectorAll('.editor-tab').forEach(tab => {
    tab.classList.remove('active');
  });
  document.querySelector(`[data-mode="${mode}"]`).classList.add('active');
  
  // Show/hide panels
  if (mode === 'wysiwyg') {
    document.getElementById('wysiwygEditor').classList.remove('hidden');
    document.getElementById('htmlEditor').classList.add('hidden');
  } else {
    document.getElementById('wysiwygEditor').classList.add('hidden');
    document.getElementById('htmlEditor').classList.remove('hidden');
    
    // Sync content from WYSIWYG to HTML
    const richTextContent = document.getElementById('richTextEditor').innerHTML;
    document.getElementById('htmlContent').value = richTextContent;
  }
}

function insertVariable(variable) {
  if (currentEditorMode === 'wysiwyg') {
    document.execCommand('insertText', false, variable);
  } else {
    const textarea = document.getElementById('htmlContent');
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const text = textarea.value;
    textarea.value = text.substring(0, start) + variable + text.substring(end);
    textarea.focus();
    textarea.setSelectionRange(start + variable.length, start + variable.length);
  }
}

async function loadAllEmails() {
  try {
    const response = await fetch('/certificates/emails');
    const result = await response.json();
    const emails = result.data.map(item => item.email);
    document.getElementById('recipients').value = emails.join('\n');
    updateRecipientCount();
  } catch (error) {
    console.error('Error loading emails:', error);
    window.showToast('Error loading email addresses', 'error');
  }
}

async function loadCertificateHolders(type) {
  try {
    const response = await fetch(`/certificates/emails?type=${type}`);
    const result = await response.json();
    const emails = result.data.map(item => item.email);
    document.getElementById('recipients').value = emails.join('\n');
    updateRecipientCount();
    window.showToast(`Loaded ${emails.length} email addresses`, 'success');
  } catch (error) {
    console.error('Error loading certificate holders:', error);
    window.showToast('Error loading certificate holders', 'error');
  }
}

function updateRecipientCount() {
  const textarea = document.getElementById('recipients');
  const emails = textarea.value.split(/[,\n]/).map(email => email.trim()).filter(email => email && validateEmail(email));
  document.getElementById('recipientCount').textContent = emails.length;
}

function validateEmail(email) {
  const re = /^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\.[a-zA-Z]{2,7}$/;
  return re.test(String(email).toLowerCase());
}

function validateEmails() {
  const textarea = document.getElementById('recipients');
  const emails = textarea.value.split(/[,\n]/).map(email => email.trim()).filter(email => email);
  const validEmails = [];
  const invalidEmails = [];
  
  emails.forEach(email => {
    if (validateEmail(email)) {
      validEmails.push(email);
    } else {
      invalidEmails.push(email);
    }
  });
  
  textarea.value = validEmails.join('\n');
  updateRecipientCount();
  
  if (invalidEmails.length > 0) {
    window.showToast(`Removed ${invalidEmails.length} invalid email addresses`, 'warning');
  } else {
    window.showToast('All email addresses are valid', 'success');
  }
}

async function applyFilters() {
  const filters = {
    certType: document.getElementById('filterCertType').value,
    dateRange: document.getElementById('filterDateRange').value,
    status: document.getElementById('filterStatus').value
  };
  
  try {
    const response = await fetch('/certificates/emails/filter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(filters)
    });
    const result = await response.json();
    const emails = result.data.map(item => item.email);
    
    document.getElementById('filteredCount').textContent = `${emails.length} recipients match criteria`;
    
    // Update recipients in manual tab
    currentRecipientMode = 'manual';
    setRecipientMode('manual');
    document.getElementById('recipients').value = emails.join('\n');
    updateRecipientCount();
    
  } catch (error) {
    console.error('Error applying filters:', error);
    window.showToast('Error applying filters', 'error');
  }
}

function handleCsvUpload(event) {
  const file = event.target.files[0];
  if (!file) return;
  
  const reader = new FileReader();
  reader.onload = function(e) {
    const csv = e.target.result;
    parseCsvData(csv);
  };
  reader.readAsText(file);
}

function parseCsvData(csv) {
  const lines = csv.split('\n');
  const headers = lines[0].split(',').map(h => h.trim());
  const data = [];
  
  for (let i = 1; i < Math.min(lines.length, 11); i++) { // Preview first 10 rows
    if (lines[i].trim()) {
      const values = lines[i].split(',').map(v => v.trim());
      data.push({
        email: values[0] || '',
        name: values[1] || '',
        status: validateEmail(values[0]) ? 'Valid' : 'Invalid'
      });
    }
  }
  
  // Display preview
  const tbody = document.getElementById('csvPreviewBody');
  tbody.innerHTML = '';
  
  data.forEach(row => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="px-3 py-2 border-b">${row.email}</td>
      <td class="px-3 py-2 border-b">${row.name}</td>
      <td class="px-3 py-2 border-b">
        <span class="text-xs px-2 py-1 rounded-full ${row.status === 'Valid' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
          ${row.status}
        </span>
      </td>
    `;
    tbody.appendChild(tr);
  });
  
  const totalRows = lines.length - 1;
  const validRows = data.filter(row => row.status === 'Valid').length;
  document.getElementById('csvStats').textContent = `${totalRows} total rows, ${validRows} valid emails`;
  
  document.getElementById('csvPreview').classList.remove('hidden');
}

function importCsvData() {
  const validEmails = [];
  const rows = document.querySelectorAll('#csvPreviewBody tr');
  
  rows.forEach(row => {
    const status = row.querySelector('.bg-green-100');
    if (status) {
      const email = row.cells[0].textContent.trim();
      validEmails.push(email);
    }
  });
  
  // Switch to manual mode and add emails
  currentRecipientMode = 'manual';
  setRecipientMode('manual');
  
  const existingEmails = document.getElementById('recipients').value.split('\n').filter(e => e.trim());
  const allEmails = [...new Set([...existingEmails, ...validEmails])];
  
  document.getElementById('recipients').value = allEmails.join('\n');
  updateRecipientCount();
  
  window.showToast(`Imported ${validEmails.length} email addresses`, 'success');
  document.getElementById('csvPreview').classList.add('hidden');
}

