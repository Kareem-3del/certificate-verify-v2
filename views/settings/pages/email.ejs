<!-- Enhanced Bulk Email Page -->
<div id="email-settings" class="settings-page hidden">
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Bulk Email Management</h2>
        <p class="text-gray-600 mt-1">Send bulk emails with advanced targeting and tracking capabilities</p>
      </div>
      <div class="flex space-x-3">
        <button onclick="showEmailHistory()" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg transition-colors duration-200 flex items-center space-x-2">
          <i data-lucide="history" class="w-4 h-4"></i>
          <span>Email History</span>
        </button>
        <button onclick="showEmailTemplates()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors duration-200 flex items-center space-x-2">
          <i data-lucide="file-text" class="w-4 h-4"></i>
          <span>Templates</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Email Campaign Builder -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900 flex items-center">
        <i data-lucide="send" class="w-5 h-5 mr-2 text-blue-600"></i>
        Create Email Campaign
      </h3>
      <p class="text-sm text-gray-600 mt-1">Design and send targeted email campaigns</p>
    </div>
    
    <div class="p-6">
      <form id="bulkEmailForm" class="space-y-6">
        
        <!-- Campaign Settings -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Campaign Name</label>
            <input type="text" id="campaignName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" placeholder="Monthly Newsletter">
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Campaign Type</label>
            <select id="campaignType" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
              <option value="newsletter">Newsletter</option>
              <option value="announcement">Announcement</option>
              <option value="reminder">Reminder</option>
              <option value="promotional">Promotional</option>
              <option value="custom">Custom</option>
            </select>
          </div>
        </div>

        <!-- Recipient Management -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-3">Recipient Management</label>
          <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
            
            <!-- Recipient Selection Tabs -->
            <div class="flex space-x-1 bg-white rounded-lg p-1 mb-4">
              <button type="button" onclick="setRecipientMode('manual')" class="recipient-tab active flex-1 px-4 py-2 text-sm font-medium rounded-md transition-colors duration-200" data-mode="manual">
                Manual List
              </button>
              <button type="button" onclick="setRecipientMode('filter')" class="recipient-tab flex-1 px-4 py-2 text-sm font-medium rounded-md transition-colors duration-200" data-mode="filter">
                Smart Filters
              </button>
              <button type="button" onclick="setRecipientMode('import')" class="recipient-tab flex-1 px-4 py-2 text-sm font-medium rounded-md transition-colors duration-200" data-mode="import">
                Import CSV
              </button>
            </div>

            <!-- Manual Recipient List -->
            <div id="manualRecipients" class="recipient-panel">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Email Addresses</label>
                  <textarea id="recipients" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" rows="8" placeholder="Enter email addresses (one per line or comma-separated)"></textarea>
                  <p class="text-xs text-gray-500 mt-1">
                    <span id="recipientCount">0</span> recipients • 
                    <button type="button" onclick="loadAllEmails()" class="text-primary-600 hover:text-primary-800">Load all certificate holders</button>
                  </p>
                </div>
                
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Quick Actions</label>
                  <div class="space-y-2">
                    <button type="button" onclick="loadCertificateHolders('all')" class="w-full px-3 py-2 bg-blue-100 hover:bg-blue-200 text-blue-800 rounded-lg text-sm transition-colors duration-200">
                      All Certificate Holders
                    </button>
                    <button type="button" onclick="loadCertificateHolders('recent')" class="w-full px-3 py-2 bg-green-100 hover:bg-green-200 text-green-800 rounded-lg text-sm transition-colors duration-200">
                      Recent Certificates (30 days)
                    </button>
                    <button type="button" onclick="loadCertificateHolders('expiring')" class="w-full px-3 py-2 bg-yellow-100 hover:bg-yellow-200 text-yellow-800 rounded-lg text-sm transition-colors duration-200">
                      Expiring Soon
                    </button>
                    <button type="button" onclick="validateEmails()" class="w-full px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg text-sm transition-colors duration-200">
                      Validate Emails
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Smart Filters -->
            <div id="filterRecipients" class="recipient-panel hidden">
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Certificate Type</label>
                  <select id="filterCertType" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                    <option value="">All Types</option>
                    <option value="CPR">CPR Certification</option>
                    <option value="First Aid">First Aid</option>
                    <option value="AED">AED Training</option>
                  </select>
                </div>
                
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Issue Date Range</label>
                  <select id="filterDateRange" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                    <option value="">All Time</option>
                    <option value="7">Last 7 days</option>
                    <option value="30">Last 30 days</option>
                    <option value="90">Last 3 months</option>
                    <option value="365">Last year</option>
                  </select>
                </div>
                
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                  <select id="filterStatus" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="expiring">Expiring Soon</option>
                    <option value="expired">Expired</option>
                  </select>
                </div>
              </div>
              
              <div class="mt-4 flex justify-between items-center">
                <button type="button" onclick="applyFilters()" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors duration-200">
                  Apply Filters
                </button>
                <span id="filteredCount" class="text-sm text-gray-600">0 recipients match criteria</span>
              </div>
            </div>

            <!-- Import CSV -->
            <div id="importRecipients" class="recipient-panel hidden">
              <div class="text-center py-8">
                <i data-lucide="upload" class="w-12 h-12 text-gray-400 mx-auto mb-4"></i>
                <h4 class="text-lg font-medium text-gray-900 mb-2">Import Email List</h4>
                <p class="text-sm text-gray-600 mb-4">Upload a CSV file with email addresses</p>
                
                <div class="max-w-md mx-auto">
                  <input type="file" id="csvFile" accept=".csv" class="hidden" onchange="handleCsvUpload(event)">
                  <button type="button" onclick="document.getElementById('csvFile').click()" class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors duration-200">
                    Choose CSV File
                  </button>
                </div>
                
                <div class="mt-4 text-xs text-gray-500">
                  <p>CSV format: email,name (optional)</p>
                  <p>Maximum 10,000 recipients per upload</p>
                </div>
              </div>
              
              <div id="csvPreview" class="hidden mt-6">
                <h5 class="text-sm font-medium text-gray-700 mb-3">Preview (first 10 rows)</h5>
                <div class="overflow-x-auto">
                  <table class="min-w-full text-sm">
                    <thead class="bg-gray-50">
                      <tr>
                        <th class="px-3 py-2 text-left font-medium text-gray-600">Email</th>
                        <th class="px-3 py-2 text-left font-medium text-gray-600">Name</th>
                        <th class="px-3 py-2 text-left font-medium text-gray-600">Status</th>
                      </tr>
                    </thead>
                    <tbody id="csvPreviewBody">
                    </tbody>
                  </table>
                </div>
                
                <div class="mt-4 flex justify-between items-center">
                  <span id="csvStats" class="text-sm text-gray-600"></span>
                  <button type="button" onclick="importCsvData()" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors duration-200">
                    Import Data
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Email Content -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Subject Line</label>
            <input type="text" id="subject" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" placeholder="Your Certificate Update">
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">From Name</label>
            <input type="text" id="fromName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" value="CertifyPro">
          </div>
        </div>

        <!-- Email Editor -->
        <div>
          <div class="flex items-center justify-between mb-3">
            <label class="block text-sm font-medium text-gray-700">Email Content</label>
            <div class="flex space-x-2">
              <button type="button" onclick="insertVariable('{{name}}')" class="text-xs px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded">
                + Name
              </button>
              <button type="button" onclick="insertVariable('{{certificate_type}}')" class="text-xs px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded">
                + Cert Type
              </button>
              <button type="button" onclick="insertVariable('{{expiry_date}}')" class="text-xs px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded">
                + Expiry Date
              </button>
            </div>
          </div>
          
          <div class="border border-gray-300 rounded-lg">
            <div class="flex border-b border-gray-200 bg-gray-50 rounded-t-lg">
              <button type="button" onclick="toggleEditor('wysiwyg')" class="editor-tab active px-4 py-2 text-sm font-medium" data-mode="wysiwyg">
                Visual
              </button>
              <button type="button" onclick="toggleEditor('html')" class="editor-tab px-4 py-2 text-sm font-medium" data-mode="html">
                HTML
              </button>
            </div>
            
            <div id="wysiwygEditor" class="editor-panel p-4">
              <div id="richTextEditor" class="min-h-[200px] focus:outline-none" contenteditable="true">
                <p>Dear {{name}},</p>
                <p>We hope this email finds you well. We're writing to inform you about your {{certificate_type}} certificate.</p>
                <p>Best regards,<br>The CertifyPro Team</p>
              </div>
            </div>
            
            <div id="htmlEditor" class="editor-panel hidden">
              <textarea id="htmlContent" class="w-full p-4 border-0 focus:ring-0 focus:outline-none resize-none" rows="10"></textarea>
            </div>
          </div>
        </div>

        <!-- Attachments -->
        <div>
          <div class="flex items-center justify-between mb-3">
            <label class="block text-sm font-medium text-gray-700">Attachments</label>
            <button type="button" onclick="addAttachment()" class="text-sm text-primary-600 hover:text-primary-800">
              + Add Attachment
            </button>
          </div>
          
          <div id="attachmentsList" class="space-y-2">
            <!-- Attachments will be added here -->
          </div>
        </div>

        <!-- Send Options -->
        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
          <h4 class="text-sm font-medium text-gray-700 mb-3">Delivery Options</h4>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Send Time</label>
              <select id="sendTime" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                <option value="now">Send Now</option>
                <option value="schedule">Schedule for Later</option>
                <option value="optimal">Optimal Time</option>
              </select>
            </div>
            
            <div id="scheduleTime" class="hidden">
              <label class="block text-sm font-medium text-gray-700 mb-2">Schedule Date/Time</label>
              <input type="datetime-local" id="scheduleDateTime" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Priority</label>
              <select id="priority" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                <option value="normal">Normal</option>
                <option value="high">High</option>
                <option value="low">Low</option>
              </select>
            </div>
          </div>
          
          <div class="flex items-center space-x-6 mt-4">
            <label class="flex items-center">
              <input type="checkbox" id="trackOpens" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked>
              <span class="ml-2 text-sm text-gray-700">Track Opens</span>
            </label>
            
            <label class="flex items-center">
              <input type="checkbox" id="trackClicks" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked>
              <span class="ml-2 text-sm text-gray-700">Track Clicks</span>
            </label>
            
            <label class="flex items-center">
              <input type="checkbox" id="allowUnsubscribe" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked>
              <span class="ml-2 text-sm text-gray-700">Include Unsubscribe</span>
            </label>
          </div>
        </div>

        <!-- Result Email -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Campaign Report Email</label>
          <input type="email" id="resultEmail" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" placeholder="admin@company.com">
          <p class="text-xs text-gray-500 mt-1">Receive detailed campaign results and analytics</p>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-between items-center pt-6 border-t border-gray-200">
          <div class="flex space-x-3">
            <button type="button" onclick="saveAsDraft()" class="px-4 py-2 text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors duration-200">
              Save as Draft
            </button>
            <button type="button" onclick="previewEmail()" class="px-4 py-2 text-blue-700 bg-blue-100 hover:bg-blue-200 rounded-lg transition-colors duration-200">
              Preview
            </button>
            <button type="button" onclick="sendTestEmail()" class="px-4 py-2 text-green-700 bg-green-100 hover:bg-green-200 rounded-lg transition-colors duration-200">
              Send Test
            </button>
          </div>
          
          <button type="submit" id="sendButton" class="px-8 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors duration-200 flex items-center space-x-2">
