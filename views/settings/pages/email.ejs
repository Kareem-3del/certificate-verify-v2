  <!-- Campaign Results -->
  <div id="campaignResults" class="hidden bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">Campaign Results</h3>
    </div>
    <div class="p-6">
      <div id="resultsContent">
        <!-- Results will be displayed here -->
      </div>
    </div>
