async function handleFormSubmit(event) {
  event.preventDefault();
  
  const formData = new FormData();
  const recipients = document.getElementById('recipients').value
    .split(/[,\n]/)
    .map(email => email.trim())
    .filter(email => email && validateEmail(email));
  
  if (recipients.length === 0) {
    window.showToast('Please add at least one valid recipient', 'error');
    return;
  }
  
  const emailData = {
    campaignName: document.getElementById('campaignName').value,
    campaignType: document.getElementById('campaignType').value,
    recipients: recipients,
    subject: document.getElementById('subject').value,
    fromName: document.getElementById('fromName').value,
    content: currentEditorMode === 'wysiwyg' 
      ? document.getElementById('richTextEditor').innerHTML
      : document.getElementById('htmlContent').value,
    resultEmail: document.getElementById('resultEmail').value,
    sendTime: document.getElementById('sendTime').value,
    scheduleDateTime: document.getElementById('scheduleDateTime').value,
    priority: document.getElementById('priority').value,
    trackOpens: document.getElementById('trackOpens').checked,
    trackClicks: document.getElementById('trackClicks').checked,
    allowUnsubscribe: document.getElementById('allowUnsubscribe').checked
  };
  
  try {
    document.getElementById('sendButton').disabled = true;
    document.getElementById('sendButton').innerHTML = '<i data-lucide="loader" class="w-4 h-4 animate-spin mr-2"></i>Sending...';
    
    const response = await fetch('/api/certificates/send-bulk-enhanced', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(emailData)
    });
    
    const result = await response.json();
    
    if (response.ok) {
      showCampaignResults(result);
      window.showToast(`Campaign sent successfully! ${result.success} emails sent`, 'success');
    } else {
      window.showToast(`Error: ${result.error}`, 'error');
    }
  } catch (error) {
    console.error('Error:', error);
    window.showToast('Error sending campaign', 'error');
  } finally {
    document.getElementById('sendButton').disabled = false;
    document.getElementById('sendButton').innerHTML = '<i data-lucide="send" class="w-4 h-4 mr-2"></i>Send Campaign';
    lucide.createIcons();
  }
}

function showCampaignResults(results) {
  const resultsDiv = document.getElementById('campaignResults');
  const contentDiv = document.getElementById('resultsContent');
  
  contentDiv.innerHTML = `
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
      <div class="bg-green-50 p-4 rounded-lg border border-green-200">
        <div class="text-2xl font-bold text-green-900">${results.success || 0}</div>
        <div class="text-sm text-green-700">Emails Sent</div>
      </div>
      <div class="bg-red-50 p-4 rounded-lg border border-red-200">
        <div class="text-2xl font-bold text-red-900">${results.failed || 0}</div>
        <div class="text-sm text-red-700">Failed</div>
      </div>
      <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
        <div class="text-2xl font-bold text-blue-900">${results.totalRecipients || 0}</div>
        <div class="text-sm text-blue-700">Total Recipients</div>
      </div>
      <div class="bg-purple-50 p-4 rounded-lg border border-purple-200">
        <div class="text-2xl font-bold text-purple-900">${Math.round(((results.success || 0) / (results.totalRecipients || 1)) * 100)}%</div>
        <div class="text-sm text-purple-700">Success Rate</div>
      </div>
    </div>
    
    ${results.failedEmails && results.failedEmails.length > 0 ? `
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <h4 class="text-sm font-medium text-red-900 mb-2">Failed Email Addresses</h4>
        <div class="text-xs text-red-700 space-y-1">
          ${results.failedEmails.map(email => `<div>${email}</div>`).join('')}
        </div>
      </div>
    ` : ''}
  `;
  
  resultsDiv.classList.remove('hidden');
  resultsDiv.scrollIntoView({ behavior: 'smooth' });
}

