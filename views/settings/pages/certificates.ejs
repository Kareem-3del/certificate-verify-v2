<!-- Certificate Settings Page -->
<div id="certificates-settings" class="settings-page hidden">
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Certificate Settings</h2>
        <p class="text-gray-600 mt-1">Configure certificate templates, validation rules, and generation settings</p>
      </div>
      <div class="flex space-x-3">
        <button onclick="addNewTemplate()" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors duration-200 flex items-center space-x-2">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Add Template</span>
        </button>
        <button onclick="saveCertificateSettings()" class="px-6 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors duration-200 flex items-center space-x-2">
          <i data-lucide="save" class="w-4 h-4"></i>
          <span>Save Changes</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Certificate Template Management -->
  <div class="mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center">
          <i data-lucide="file-text" class="w-5 h-5 mr-2 text-blue-600"></i>
          Certificate Templates
        </h3>
        <p class="text-sm text-gray-600 mt-1">Manage and configure certificate templates</p>
      </div>
      
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="templatesGrid">
          <!-- Template cards will be dynamically loaded here -->
        </div>
      </div>
    </div>
  </div>

  <!-- Certificate Configuration -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    
    <!-- Validation Settings -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex items-center space-x-3 mb-4">
        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
          <i data-lucide="check-circle" class="w-5 h-5 text-green-600"></i>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Validation Settings</h3>
          <p class="text-sm text-gray-600">Certificate validation and verification rules</p>
        </div>
      </div>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Default Validity Period</label>
          <select id="validityPeriod" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="365">1 Year</option>
            <option value="730">2 Years</option>
            <option value="1095">3 Years</option>
            <option value="1825">5 Years</option>
            <option value="0">Never Expires</option>
          </select>
        </div>
        
        <div class="flex items-center justify-between">
          <div>
            <label class="text-sm font-medium text-gray-700">Automatic Renewal</label>
            <p class="text-xs text-gray-500">Auto-renew certificates before expiry</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="autoRenewal" class="sr-only peer">
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
          </label>
        </div>
        
        <div class="flex items-center justify-between">
          <div>
            <label class="text-sm font-medium text-gray-700">Digital Signatures</label>
            <p class="text-xs text-gray-500">Add digital signature to PDFs</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="digitalSignatures" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
          </label>
        </div>
        
        <div class="flex items-center justify-between">
          <div>
            <label class="text-sm font-medium text-gray-700">QR Code Verification</label>
            <p class="text-xs text-gray-500">Include QR codes for verification</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="qrVerification" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- PDF Generation Settings -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex items-center space-x-3 mb-4">
        <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
          <i data-lucide="file-text" class="w-5 h-5 text-red-600"></i>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">PDF Generation</h3>
          <p class="text-sm text-gray-600">Configure PDF output settings</p>
        </div>
      </div>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">PDF Quality</label>
          <select id="pdfQuality" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="high">High Quality (Large file)</option>
            <option value="medium" selected>Medium Quality (Balanced)</option>
            <option value="low">Low Quality (Small file)</option>
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Default Font</label>
          <select id="defaultFont" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="Helvetica">Helvetica</option>
            <option value="Times-Roman">Times Roman</option>
            <option value="Courier">Courier</option>
            <option value="Arial">Arial</option>
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Font Size</label>
          <input type="number" id="fontSize" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" value="12" min="8" max="72">
        </div>
        
        <div class="flex items-center justify-between">
          <div>
            <label class="text-sm font-medium text-gray-700">Watermark</label>
            <p class="text-xs text-gray-500">Add watermark to certificates</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="watermark" class="sr-only peer">
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
          </label>
        </div>
        
        <div class="flex items-center justify-between">
          <div>
            <label class="text-sm font-medium text-gray-700">Generate ID Cards</label>
            <p class="text-xs text-gray-500">Create separate ID card files</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="generateIdCards" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Email Configuration -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
    <div class="flex items-center space-x-3 mb-4">
      <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
        <i data-lucide="mail" class="w-5 h-5 text-purple-600"></i>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Email Delivery Settings</h3>
        <p class="text-sm text-gray-600">Configure automatic certificate delivery</p>
      </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <label class="text-sm font-medium text-gray-700">Auto-send Certificates</label>
            <p class="text-xs text-gray-500">Automatically email certificates after generation</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="autoSendEmail" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
          </label>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Email Template</label>
          <select id="emailTemplate" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            <option value="default">Default Template</option>
            <option value="professional">Professional Template</option>
            <option value="minimal">Minimal Template</option>
            <option value="custom">Custom Template</option>
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">From Name</label>
          <input type="text" id="emailFromName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" value="CertifyPro Certificates">
        </div>
      </div>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Subject Line</label>
          <input type="text" id="emailSubject" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" value="Your Certificate is Ready">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Email Message</label>
          <textarea id="emailMessage" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" rows="4" placeholder="Congratulations! Your certificate is attached to this email..."></textarea>
        </div>
        
        <div class="flex items-center justify-between">
          <div>
            <label class="text-sm font-medium text-gray-700">Include ID Card</label>
            <p class="text-xs text-gray-500">Attach ID card along with certificate</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="includeIdCard" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
          </label>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Template Modal -->
<div id="templateModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
  <div class="bg-white rounded-xl shadow-xl max-w-4xl w-full mx-4 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between p-6 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">Edit Template</h3>
      <button onclick="closeTemplateModal()" class="text-gray-400 hover:text-gray-600">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>
    
    <div class="p-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Template Preview -->
        <div>
          <h4 class="text-sm font-medium text-gray-700 mb-3">Template Preview</h4>
          <div class="border border-gray-300 rounded-lg p-4 bg-gray-50">
            <div id="templatePreview" class="w-full h-64 bg-white border border-gray-200 rounded shadow-sm">
              <!-- Template preview will be rendered here -->
            </div>
          </div>
        </div>
        
        <!-- Template Settings -->
        <div>
          <h4 class="text-sm font-medium text-gray-700 mb-3">Template Settings</h4>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Template Name</label>
              <input type="text" id="templateName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Certificate Type</label>
              <input type="text" id="certificateType" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Background Image</label>
              <input type="file" id="backgroundImage" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" accept="image/*">
            </div>
            
            <div class="flex items-center justify-between">
              <div>
                <label class="text-sm font-medium text-gray-700">Active Template</label>
                <p class="text-xs text-gray-500">Enable this template for use</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="templateActive" class="sr-only peer">
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
              </label>
            </div>
          </div>
        </div>
      </div>
      
      <div class="flex justify-end space-x-3 mt-6 pt-6 border-t border-gray-200">
        <button onclick="closeTemplateModal()" class="px-4 py-2 text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors duration-200">
          Cancel
        </button>
        <button onclick="saveTemplate()" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors duration-200">
          Save Template
        </button>
      </div>
    </div>
  </div>
</div>

<script>
let currentTemplateId = null;

function loadCertificateTemplates() {
  fetch('/certificates/templates')
    .then(response => response.json())
    .then(result => {
      const templates = result.data || [];
      const grid = document.getElementById('templatesGrid');
      grid.innerHTML = '';
      
      templates.forEach(template => {
        const card = createTemplateCard(template);
        grid.appendChild(card);
      });
    })
    .catch(error => {
      console.error('Error loading templates:', error);
      window.showToast('Error loading certificate templates', 'error');
    });
}

function createTemplateCard(template) {
  const div = document.createElement('div');
  div.className = 'bg-gray-50 rounded-lg border border-gray-200 p-4 hover:shadow-md transition-shadow duration-200';
  div.innerHTML = `
    <div class="flex items-center justify-between mb-3">
      <h4 class="font-medium text-gray-900">${template.name}</h4>
      <span class="text-xs px-2 py-1 rounded-full ${template.active ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600'}">
        ${template.active ? 'Active' : 'Inactive'}
      </span>
    </div>
    <div class="w-full h-32 bg-white border border-gray-200 rounded mb-3 overflow-hidden">
      <img src="${template.preview || '/images/template-placeholder.png'}" alt="Template preview" class="w-full h-full object-cover">
    </div>
    <div class="flex space-x-2">
      <button onclick="editTemplate(${template.id})" class="flex-1 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded-lg transition-colors duration-200">
        Edit
      </button>
      <button onclick="deleteTemplate(${template.id})" class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition-colors duration-200">
        <i data-lucide="trash" class="w-4 h-4"></i>
      </button>
    </div>
  `;
  return div;
}

function addNewTemplate() {
  currentTemplateId = null;
  document.getElementById('templateName').value = '';
  document.getElementById('certificateType').value = '';
  document.getElementById('templateActive').checked = true;
  document.getElementById('templateModal').classList.remove('hidden');
}

function editTemplate(templateId) {
  currentTemplateId = templateId;
  
  fetch(`/certificates/templates/${templateId}`)
    .then(response => response.json())
    .then(result => {
      const template = result.data || {};
      document.getElementById('templateName').value = template.name;
      document.getElementById('certificateType').value = template.description;
      document.getElementById('templateActive').checked = true;
      document.getElementById('templateModal').classList.remove('hidden');
    })
    .catch(error => {
      console.error('Error loading template:', error);
      window.showToast('Error loading template', 'error');
    });
}

function deleteTemplate(templateId) {
  if (confirm('Are you sure you want to delete this template?')) {
    fetch(`/certificates/templates/${templateId}`, {
      method: 'DELETE'
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        window.showToast('Template deleted successfully', 'success');
        loadCertificateTemplates();
      } else {
        window.showToast('Error deleting template', 'error');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      window.showToast('Error deleting template', 'error');
    });
  }
}

function closeTemplateModal() {
  document.getElementById('templateModal').classList.add('hidden');
}

function saveTemplate() {
  const templateData = {
    name: document.getElementById('templateName').value,
    type: document.getElementById('certificateType').value,
    active: document.getElementById('templateActive').checked
  };

  const url = currentTemplateId 
    ? `/api/certificates/templates/${currentTemplateId}` 
    : '/api/certificates/templates';
  
  const method = currentTemplateId ? 'PUT' : 'POST';

  fetch(url, {
    method: method,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(templateData)
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      window.showToast('Template saved successfully', 'success');
      closeTemplateModal();
      loadCertificateTemplates();
    } else {
      window.showToast('Error saving template', 'error');
    }
  })
  .catch(error => {
    console.error('Error:', error);
    window.showToast('Error saving template', 'error');
  });
}

function saveCertificateSettings() {
  const settings = {
    validityPeriod: document.getElementById('validityPeriod').value,
    autoRenewal: document.getElementById('autoRenewal').checked,
    digitalSignatures: document.getElementById('digitalSignatures').checked,
    qrVerification: document.getElementById('qrVerification').checked,
    pdfQuality: document.getElementById('pdfQuality').value,
    defaultFont: document.getElementById('defaultFont').value,
    fontSize: document.getElementById('fontSize').value,
    watermark: document.getElementById('watermark').checked,
    generateIdCards: document.getElementById('generateIdCards').checked,
    autoSendEmail: document.getElementById('autoSendEmail').checked,
    emailTemplate: document.getElementById('emailTemplate').value,
    emailFromName: document.getElementById('emailFromName').value,
    emailSubject: document.getElementById('emailSubject').value,
    emailMessage: document.getElementById('emailMessage').value,
    includeIdCard: document.getElementById('includeIdCard').checked
  };

  fetch('/api/settings/certificates', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(settings)
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      window.showToast('Certificate settings saved successfully', 'success');
    } else {
      window.showToast('Error saving settings', 'error');
    }
  })
  .catch(error => {
    console.error('Error:', error);
    window.showToast('Error saving settings', 'error');
  });
}

// Load templates when page loads
document.addEventListener('DOMContentLoaded', loadCertificateTemplates);
</script>